{% extends 'base.html.twig' %}
{% block title %}{{ name }}{% endblock %}
{% block body %}<main><h1>{{ name }}</h1><p><a href="{{ path(create_route) }}">Add job</a></p><ul>{% for item in items %}<li>{{ item.label ?? 'Unnamed' }} — <a href="{{ path(edit_route, {id: item.id}) }}">Edit</a></li>{% else %}<li>No jobs.</li>{% endfor %}</ul></main>{% endblock %}
