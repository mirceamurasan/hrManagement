{% extends 'base.html.twig' %}
{% block title %}{{ name }}{% endblock %}
{% block body %}<main><h1>{{ name }}</h1><p><a href="{{ path(create_route) }}">Add provider</a></p><ul>{% for item in items %}<li>{{ item.name }} — <a href="{{ path(edit_route, {id: item.id}) }}">Edit</a></li>{% else %}<li>No providers.</li>{% endfor %}</ul></main>{% endblock %}
