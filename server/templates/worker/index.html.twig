{% extends 'base.html.twig' %}
{% block title %}Workers{% endblock %}
{% block body %}
    <main>
        <h1>Workers</h1>
        <p><a href="{{ path('admin_worker_new') }}">Add worker</a></p>
        <table><thead><tr><th>Name</th><th>Account</th><th>Job</th><th>Team</th><th>Location</th><th>Dates</th><th>Actions</th></tr></thead><tbody>
        {% for worker in workers %}<tr><td>{{ worker.name }}</td><td>{{ worker.account ? worker.account.email : '—' }}</td><td>{{ worker.job ? worker.job.label : '—' }}</td><td>{{ worker.team ? worker.team.name : '—' }}</td><td>{{ worker.location ? worker.location.name : '—' }}</td><td>{{ worker.startDate ? worker.startDate|date('Y-m-d') : '—' }} – {{ worker.endDate ? worker.endDate|date('Y-m-d') : '—' }}</td><td><a href="{{ path('admin_worker_edit', {id: worker.id}) }}">Edit</a></td></tr>{% else %}<tr><td colspan="7">No workers.</td></tr>{% endfor %}
        </tbody></table>
    </main>
{% endblock %}
