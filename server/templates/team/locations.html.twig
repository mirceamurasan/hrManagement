{% extends 'base.html.twig' %}
{% block title %}Locations{% endblock %}
{% block body %}<main><h1>Locations</h1><p><a href="{{ path('admin_location_new') }}">Add location</a></p><ul>{% for item in items %}<li>{{ item.name }}{% if item.address %} — {{ item.address }}{% endif %}</li>{% else %}<li>No locations.</li>{% endfor %}</ul></main>{% endblock %}
